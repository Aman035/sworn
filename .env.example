# Copy to .env and fill in. .env is gitignored; never commit a key.
# CI reads the same names from repository secrets.

# --- Archive RPCs (required: eth_getLogs over long ranges, archive state, debug_traceCall) ---
BASE_RPC_ARCHIVE=
BNB_RPC_ARCHIVE=
ARB_RPC_ARCHIVE=
UNI_RPC_ARCHIVE=
ETH_RPC_ARCHIVE=
POLYGON_RPC_ARCHIVE=

# --- Block explorers (verified source + hook tx history) ---
# Etherscan V2 uses one key across chains; ETHERSCAN_KEYS stays for per-chain overrides
# in the form chain=key,chain=key (e.g. base=ABC,bnb=DEF).
ETHERSCAN_KEY=
ETHERSCAN_KEYS=

# --- Attestor (Phase 7). Use a dedicated key with only enough gas to write HookBook. ---
ATTESTOR_PK=
HOOKBOOK_ADDRESS_BASE=

# --- Dashboard / indexer (Phase 2, Phase 9) ---
DATABASE_URL=
DASHBOARD_DB_URL=

# --- Optional: price source fallback for long-tail tokens (Phase 2) ---
COINGECKO_API_KEY=
