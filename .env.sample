# Copy to .env and fill in.  `cp .env.sample .env`
# .env is gitignored; never commit a key. CI reads the same names from repo secrets.
#
# ---------------------------------------------------------------------------
# ARCHIVE RPCs  (required from Phase 2 onward)
# ---------------------------------------------------------------------------
# These are MAINNET endpoints and every use is READ-ONLY. Sworn sends no
# transactions through them: it reads logs, reads archive state, and runs forks
# locally with anvil. Toxic hooks only exist on mainnet, so there is nothing to
# measure on a testnet.
#
# Each endpoint must support:
#   * eth_getLogs over wide block ranges   (census, Phase 2)
#   * archive state at arbitrary blocks    (re-quote, Phases 3 and 6)
#   * debug_traceCall                      (probe trace mode, Phase 4)
#
# Priority: BASE and BNB first — that is where the hooks 0x named live. The
# other four can stay empty and their pipelines will skip with a clear message.

BASE_RPC_ARCHIVE=
BNB_RPC_ARCHIVE=
ARB_RPC_ARCHIVE=
UNI_RPC_ARCHIVE=
ETH_RPC_ARCHIVE=
POLYGON_RPC_ARCHIVE=

# ---------------------------------------------------------------------------
# BLOCK EXPLORER  (Phase 2: verified source, proxy detection, hook tx history)
# ---------------------------------------------------------------------------
# Etherscan V2: one key covers every supported chain via ?chainid=<id>.
ETHERSCAN_KEY=
# Optional per-chain overrides, "chain=key,chain=key" (e.g. bnb=ABC,polygon=DEF).
ETHERSCAN_KEYS=

# ---------------------------------------------------------------------------
# ATTESTOR  (Phase 7 only — leave empty until then)
# ---------------------------------------------------------------------------
# A dedicated key holding only enough gas to write HookBook. Never a key that
# holds funds. This is the only secret here that can move value.
ATTESTOR_PK=
HOOKBOOK_ADDRESS_BASE=
# Testnet deployment target for the Phase 7 exit criteria.
BASE_SEPOLIA_RPC=

# ---------------------------------------------------------------------------
# INDEXER / DASHBOARD  (Phases 2 and 9)
# ---------------------------------------------------------------------------
DATABASE_URL=
DASHBOARD_DB_URL=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# Price fallback for long-tail tokens where no v3/v4 TWAP is usable (Phase 2).
COINGECKO_API_KEY=
