# node
node_modules/
.pnpm-store/
dist/
build/
*.tsbuildinfo
.next/
out/

# foundry
contracts/out/
contracts/cache/
contracts/broadcast/*/dry-run/
contracts/.gas-snapshot.tmp

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# env / secrets
.env
.env.*
!.env.sample

# data (snapshots are large; only manifests are tracked)
# Ignore everything under a snapshot directory, then re-admit the manifests. Listing
# extensions individually kept missing new ones: `*.jsonl` did not cover `initialize.jsonl.gz`,
# and a 181 MB raw pull reached a commit because of it.
data/snapshots/**
!data/snapshots/
!data/snapshots/*/
!data/snapshots/**/MANIFEST.json
!data/snapshots/README.md
data/cache/

# os / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
