  "fields": [
    {
      "name": "divergenceScore",
      "type": "integer or null",
      "why": "0 (clean) to 100 (avoid), or null when too few fills have been measured to say. Null rather than 0, so an unmeasured hook can never be mistaken for a clean one."
    },
    {
      "name": "divergenceAsOfBlock",
      "type": "integer",
      "why": "The block the measurement describes. A score with no block is a score with no shelf life, and hooks change."
    },
    {
      "name": "divergenceSnapshot",
      "type": "string",
      "why": "sha256 of the dataset the score was computed from, so a reader can re-derive the number instead of trusting it."
    },
    {
      "name": "envSensitive",
      "type": "boolean",
      "why": "The hook executes an environment read (`GASPRICE`, `ORIGIN`, `COINBASE`, `NUMBER`, `PREVRANDAO`) on the swap path. Attributed by call-stack, so a read made by a library the hook calls still counts and a read made elsewhere does not."
    },
    {
      "name": "intermittent",
      "type": "boolean",
      "why": "The hook's charged rate crosses the threshold in some hours and not others. A one-shot review of an intermittent hook is a coin flip."
    },
    {
      "name": "upgradeable",
      "type": "boolean",
      "why": "Already partly implied by `deployer`, but stated directly: today's bytecode is not tomorrow's, and listing is permanent while code is not."
    }
  ],
