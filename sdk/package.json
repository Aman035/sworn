{
  "name": "sworn-sdk",
  "version": "0.0.0",
  "description": "Build SwornRouter calldata from a quote; viem action and adapters.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "license": "MIT",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
